/*DSG{{*/
mainForm = win.form(text="Gif123 - 录屏工具";right=723;bottom=512;bgcolor=0x4882D4;border="none")
mainForm.add(
btnCopy={cls="plus";text="复制";left=158;top=0;right=225;bottom=30;align="left";color=0x3C3C3C;disabled=1;dl=1;dt=1;font=LOGFONT(h=-13);iconStyle={align="left";font=LOGFONT(h=-13;name='FontAweso[...]},
btnScreenshot={cls="plus";text='\uF06E';left=226;top=0;right=293;bottom=30;align="left";color=0x3C3C3C;dl=1;dt=1;font=LOGFONT(h=-13;name='FontAwesomeGif123');notify=1;z=12};
// ... existing controls ...
)
/*}}*/

// ... existing initialization ...

mainForm.btnScreenshot.oncommand = function(id,event){
    // 简单的截图模式选择弹窗
    var menu = win.ui.popmenu(mainForm);
    menu.add("Select area", function(){
        var ret = screenshot.capture("select", mainForm);
        if(ret){ mainForm.setCurrentPreviewImage(ret.path); mainForm.chkPreview.checked = true; mainForm.chkPreview.oncommand(); }
    });
    menu.add("Full screen", function(){
        var ret = screenshot.capture("fullscreen", mainForm);
        if(ret){ mainForm.setCurrentPreviewImage(ret.path); mainForm.chkPreview.checked = true; mainForm.chkPreview.oncommand(); }
    });
    menu.add("Capture preview", function(){
        var ret = screenshot.capture("preview", mainForm);
        if(ret){ mainForm.setCurrentPreviewImage(ret.path); mainForm.chkPreview.checked = true; mainForm.chkPreview.oncommand(); }
    });
    menu.popup(owner.left + 100, owner.top + 30);
}

// 注册默认热键（如果用户已启用）
import win.ui.accelerator;
var screenshotAccelerator = null;
function tryRegisterScreenshotHotkey(){
    if(!config.setting.screenshot_enable_hotkey) {
        if(screenshotAccelerator){ screenshotAccelerator.dispose && screenshotAccelerator.dispose(); screenshotAccelerator = null; }
        return true;
    }
    var hk = config.setting.screenshot_hotkey;
    if(!hk) return true;
    try{
        screenshotAccelerator && screenshotAccelerator.dispose && screenshotAccelerator.dispose();
        screenshotAccelerator = win.ui.accelerator({{ ctrl = hk.ctrl; shift = hk.shift; alt = hk.alt; vkey = hk.vkey; oncommand = function(){ mainForm.btnScreenshot.oncommand(); } }});
        return true;
    }
    catch(e){
        io.print("register screenshot hotkey failed:" ++ tostring(e));
        screenshotAccelerator = null;
        return false;
    }
}

// expose to other modules (settings dialog will call this to test/register)
mainForm.tryRegisterScreenshotHotkey = tryRegisterScreenshotHotkey;

// initial attempt
tryRegisterScreenshotHotkey();

// when settings saved, caller should invoke tryRegisterScreenshotHotkey again (settings dialog does save)

