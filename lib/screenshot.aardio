// Screenshot helper - lib/screenshot.aardio
// 提供截图功能（全屏、选区、捕获预览）并可选地调用水印与识码
import config;
import soImage;
import win;
import gdip;
import watermark = import("lib/watermark.aardio");
import zbar; // aardio 自带 zbar

// captureFullScreen() -> soImage
function captureFullScreen(){
    var img = soImage();
    // 0,0,0,0 表示全屏（若 API 不同，可调整）
    img.capture();
    return img;
}

// capturePreview(mainForm.plusPreview) -> soImage
function capturePreview(mainForm){
    var hwndPreview = mainForm.plusPreview.hwnd;
    var x,y,cx,cy = win.getPos(hwndPreview,true);
    var img = soImage();
    img.capture(,x,y,cx,cy);
    return img;
}

// captureSelect() -> soImage (简单覆盖窗口实现)
function captureSelect(){
    // 创建全屏遮罩窗口，用户拖拽矩形返回区域
    var sw = win.getSystemMetrics(0);
    var sh = win.getSystemMetrics(1);
    var overlay = win.form(text="";left=0;top=0;right=sw;bottom=sh;bgcolor=0x80000000;border="none";mode="popup";alpha=120);
    var startX=0,startY=0,endX=0,endY=0;
    var selRect = null;

    overlay.onMouseDown = function(wParam,lParam){
        startX = lParam & 0xFFFF; startY = lParam >> 16;
        selRect = {left=startX;top=startY;right=startX;bottom=startY};
    }
    overlay.onMouseMove = function(wParam,lParam){
        if(!selRect) return;
        endX = lParam & 0xFFFF; endY = lParam >> 16;
        selRect.right = endX; selRect.bottom = endY;
        owner.redraw();
    }
    overlay.onMouseUp = function(wParam,lParam){
        if(!selRect) return;
        overlay.close();
    }

    overlay.onPaint = function(g){
        if(selRect){
            var l = math.min(selRect.left, selRect.right);
            var t = math.min(selRect.top, selRect.bottom);
            var r = math.max(selRect.left, selRect.right);
            var b = math.max(selRect.top, selRect.bottom);
            g.fillRect(l,t,r,b,0x40FFFFFF);
            g.frameRect(l,t,r,b,0xFF77B200,2);
        }
    }

    overlay.show(true);
    win.loopMessage();

    if(!selRect) return null;
    var l = math.min(selRect.left, selRect.right);
    var t = math.min(selRect.top, selRect.bottom);
    var r = math.max(selRect.left, selRect.right);
    var b = math.max(selRect.top, selRect.bottom);
    var w = r - l; var h = b - t;
    if(w<=0 || h<=0) return null;

    var img = soImage();
    img.capture(,l,t,w,h);
    return img;
}

// save soImage to PNG file (path), return true/false
function saveSoImageAsPng(img,path){
    if(!img) return false;
    try{
        if(img.saveToFile){
            img.saveToFile(path);
            return true;
        }
        else{
            var buf = img.saveToBuffer && img.saveToBuffer("png") || img.toBuffer && img.toBuffer();
            if(#buf){
                io.saveBuffer(path,buf);
                return true;
            }
        }
    }
    catch(e){ io.print("saveSoImageAsPng error:" ++ tostring(e)); }
    return false;
}

// copy image to clipboard - best effort
function copySoImageToClipboard(img){
    try{
        var tmp = io.tempName() ++ ".png";
        if(saveSoImageAsPng(img,tmp)){
            import win.clip;
            // 尝试用通用方式把图片路径写入剪贴板
            if(win.clip && win.clip.image){
                win.clip.image.write(tmp);
            }
            elseif(win.clip && win.clip.write){
                win.clip.write(tmp);
            }
            else if(win.clip && win.clip.gif){
                win.clip.gif.write(tmp);
            }
            io.remove(tmp);
            return true;
        }
    }
    catch(e){ io.print("copySoImageToClipboard error:" ++ tostring(e)); }
    return false;
}

// run zbar scanner on soImage, return array of {type,data,rect}
function scanImageWithZbar(img){
    var results = {};
    try{
        var scanner = zbar.scanner();
        scanner.config('enable');
        // zbar 提供 scanSoImage
        scanner.scanSoImage(img, function(typeName,data,x,y,w,h){
            table.push(results,{ type=typeName; data=data; rect={x=x;y=y;w=w;h=h} });
        });
        scanner.delete && scanner.delete();
    }
    catch(e){ io.print("scanImageWithZbar error:" ++ tostring(e)); }
    return results;
}

// annotate image with rectangles and optional labels, save to new path and return path
function annotateAndSaveImage(img, codes, outPath){
    try{
        var buf = img.saveToBuffer && img.saveToBuffer("png") || img.toBuffer && img.toBuffer();
        if(!#buf) return null;
        var bmp = gdip.bitmap(buf);
        if(!bmp) return null;
        var g = gdip.graphics(bmp);
        var pen = gdip.pen(0xFFFF0000, 3);
        var font = gdip.font("Arial", 12);
        var brush = gdip.brush(0xFF000000);
        for(i=1; #codes; 1){
            var c = codes[i];
            if(c.rect){
                var x = c.rect.x; var y = c.rect.y; var w = c.rect.w; var h = c.rect.h;
                g.drawRect(x,y,w,h,pen);
                g.drawString(c.data, font, brush, x, y + h + 2);
            }
        }
        var outBuf = bmp.saveToBuffer && bmp.saveToBuffer("png");
        if(#outBuf){ io.saveBuffer(outPath,outBuf); }
        g.dispose && g.dispose(); bmp.dispose && bmp.dispose();
        return outPath;
    }
    catch(e){ io.print("annotateAndSaveImage error:" ++ tostring(e)); return null; }
}

// show scan results dialog and offer actions
function showScanResults(mainForm, codes, img, outPath){
    if(!#codes) return;
    var dlg = win.form(text="Scan results";left=0;top=0;right=480;bottom=340;mode="popup");
    var list = dlg.add({cls="listbox";left=10;top=10;right=460;bottom=240});
    for(i=1; #codes; 1){
        var c = codes[i];
        list.add(string.format("[%s] %s", c.type, tostring(c.data)));
    }

    var btnCopy = dlg.add({cls="plus";text="Copy All";left=10;top=250;right=110;bottom=280});
    var btnAnnotate = dlg.add({cls="plus";text="Annotate & Save";left=120;top=250;right=270;bottom=280});
    var btnOpen = dlg.add({cls="plus";text="Open URL";left=280;top=250;right=380;bottom=280});
    var btnClose = dlg.add({cls="plus";text="Close";left=390;top=250;right=460;bottom=280});

    btnCopy.oncommand = function(){
        var all = "";
        for(i=1; #codes; 1){ all = all ++ tostring(codes[i].data) ++ "\r\n"; }
        import win.clip;
        win.clip.write(all);
    }
    btnAnnotate.oncommand = function(){
        var dir = fsys.environment.expand(config.setting.outputDir);
        io.createDir(dir);
        var path = io.joinpath(dir, "screenshot_annotated_" ++ tostring(time(),"%Y%m%d%H%M%S") ++ ".png");
        var saved = annotateAndSaveImage(img, codes, path);
        if(saved){
            dlg.msgbox = function(){ mainForm.msgbox('Annotated saved: ' ++ saved); };
        }
    }
    btnOpen.oncommand = function(){
        // open selected entry URL if any
        var idx = list.getCurSel();
        if(!idx) return;
        var entry = codes[idx];
        if(entry && entry.data && string.find(entry.data, "^https?://")){
            import process;
            process.openUrl(entry.data);
        }
    }
    btnClose.oncommand = function(){ dlg.close(); }

    win.ui.simpleWindow(dlg);
    dlg.show(true);
}

// main entry: capture(mode, options) where mode = "select"|"fullscreen"|"preview"
function capture(mode, mainForm, options){
    options = options || {};
    var img = null;
    if(mode=="fullscreen") img = captureFullScreen();
    elseif(mode=="preview") img = capturePreview(mainForm);
    else img = captureSelect();

    if(!img) return null;

    // apply watermark if enabled
    watermark.drawWatermarkOnSoImage(img);

    // save to output dir
    var outDir = fsys.environment.expand(config.setting.outputDir) || fsys.environment.expand("%LocalAppData%/gif123");
    io.createDir(outDir);
    var filename = "screenshot_" ++ tostring(time(),"%Y%m%d%H%M%S") ++ ".png";
    var outPath = io.joinpath(outDir, filename);
    saveSoImageAsPng(img,outPath);

    // copy to clipboard
    copySoImageToClipboard(img);

    // detect codes if enabled
    var codes = {};
    if(config.setting.screenshot_detect_code){
        codes = scanImageWithZbar(img);
        if(#codes){
            showScanResults(mainForm, codes, img, outPath);
        }
    }

    return { image = img; path = outPath; codes = codes };
}

return { capture = capture, captureSelect = captureSelect, captureFullScreen = captureFullScreen, capturePreview = capturePreview, saveSoImageAsPng = saveSoImageAsPng, copySoImageToClipboard = copySoImageToClipboard, scanImageWithZbar = scanImageWithZbar };
