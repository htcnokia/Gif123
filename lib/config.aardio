//config 配置
import fsys.config;
config  = fsys.config(io.appData("/gif123/config/")); 

config.setting.mix(
	pathOutput = io.appData("gif123/screenshots.gif"); 
	outputDir = "%LocalAppData%/gif123"; 
	outputFilename = "screenshots.gif";
	gifsicleArgs3 = _WIN10_LATER ? "--optimize=3 --lossy=0 --colors 0" : "--optimize=1 --lossy=0 --colors 0";
	chkOptimize = true;
	chkShrink = true;
	chkHighlight = false;
	highlightColorPalette = {0x90668800,0x90B61E2B,0x81FF8C00,0x80006400,0x8F3A2898,0x8F008B8B};
	highlightSize = 64;
	highlightPadding = 13;
	highlightColor = 0x90668800;
	pointerSize = 100;
	captureMouse = true;
	recordHotkey = {2/*_MOD_CONTROL*/|4/*_MOD_SHIFT*/|1/*_MOD_ALT*/;'Z'#};
	countdown = 0;
	fps = 12;

	// Watermark (内嵌水印设置)
	watermark_enabled = true;
	watermark_text = "Gif123";           // 默认可修改为 ""
	watermark_color = 0xFFFFFFFF;        // 0xAARRGGBB（白色）
	watermark_size = 16;                 // 字号(px)
	watermark_position = "bottom-right"; // top-left/top-right/bottom-left/bottom-right/center
	watermark_frameInterval = 1;         // 每隔多少帧出现一次（1 表示每帧都出现）
	watermark_appearMode = "none";     // none / rotate / fade / slide
	watermark_rotationAngle = 30;        // rotate 时的旋转角度步长（度）
);

//不需要序列化的配置名字前请添加下划线
namespace config {
	__pathRecording = ..io.appData("gif123/config/recording.~");
	__pathUnoptimizedPreview = ..io.appData("gif123/config/preview.~"); 
}

/**intellisense(config)
? = 配置文件名\n!fsys_table.
setting = 配置文件名\n!fsys_table.
end intellisense**/
