 // ========== Watermark initialization & events ==========
 import fsys.environment;
 winform.chkWatermark.checked = config.setting.watermark_enabled;
 winform.editWatermarkText.text = config.setting.watermark_text || "";
 winform.editWatermarkColor.text = string.format("#%08X", config.setting.watermark_color || 0xFFFFFFFF);
 winform.editWatermarkSize.text = tostring(config.setting.watermark_size || 16);
