 winform.chkDetectCode.checked = config.setting.screenshot_detect_code || false;
 winform.cmbCodeEngine.setText(config.setting.screenshot_code_engine || "zbar");
 
 winform.btnPickColor.oncommand = function(id,event){
     import win.color;
     var clr = win.color(getColor=true,owner=winform);
     if(clr !== null){
         winform.editWatermarkColor.text = "#" ++ string.format("%08X",clr);
         winform.btnSave.disabled = false;
     }
 }
 
 winform.btnEditHotkey.oncommand = function(){
     // 简单的热键编辑弹窗
     var dlg = win.form(text="Press new hotkey";left=0;top=0;right=300;bottom=120;mode="popup");
     var lb = dlg.add({cls="plus";text="Press desired key combo (Esc to cancel)";left=10;top=10;right=290;bottom=40});
     dlg.onKeyDown = function(vkey,flags){
         if(vkey==0x1B){ dlg.close(); return; }
         var combo = {ctrl = (flags & 2) != 0; shift = (flags & 4) != 0; alt = (flags & 1) != 0; vkey = vkey};
         config.setting.screenshot_hotkey = combo;
         winform.btnSave.disabled = false;
         dlg.close();
     }
     win.ui.simpleWindow(dlg);
     dlg.show(true);
 }
 
